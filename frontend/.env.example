# Copy to .env.local and fill in per environment. .env.local is
# gitignored -- everyone sets their own, never commit real values.

VITE_API_BASE_URL=http://localhost:8080

# Dashboard (all optional). By default the dashboard looks for the nodes and the
# launcher on whatever host served the page, so it works on localhost and, opened
# from a phone, on your computer's LAN address, with no configuration.
# VITE_NODE_HOST=localhost
# VITE_NODE_PORTS=8101,8102,8103
# VITE_LAUNCHER_URL=http://localhost:8099

# Hosted demo (Vercel dashboard + Render backend behind scripts/gateway.mjs): set these
# in the Vercel project's environment variables, not here. See docs/DEPLOYMENT.md.
# VITE_NODE_URLS=https://raftkv-demo.onrender.com/n/1,https://raftkv-demo.onrender.com/n/2,https://raftkv-demo.onrender.com/n/3
# VITE_LAUNCHER_URL=https://raftkv-demo.onrender.com/launcher
